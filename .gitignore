# 数据库与 WAL（生产数据，勿入库；用 backup_db.py 单独备份）
*.db
*.db-wal
*.db-shm
miner_monitor.db*

# 备份
backups/

# 运行时生成的配置（网页可改的覆盖项）
*.settings.json
settings.json

# 日志(logs.py 轮转输出到 logs/)
*.log
server.log
logs/

# 测试缓存
.pytest_cache/

# 敏感/本机文件：git 更新流程(updater.py)要求这些永不入库——更新永远不碰配置和数据
config.yaml
segments.json
cloud_site_id.txt
# 网页/命令行改密码时的备份与临时文件(未忽略会让更新器以"工作区有改动"拒绝更新)
config.yaml.bak
config.yaml.tmp
# 更新器状态(坏版本记录/新版本启动回滚标记)
.update_state.json
.update_state.json.tmp
# HTTPS 证书与私钥
certs/
*.pem

